{
  "name": "water-levels-api",
  "main": "index.ts",
  "compatibility_date": "2026-10-01",
  // The station list's module imports src/http.ts, whose FTP client imports node:net, though the Worker never runs it.
  "compatibility_flags": ["nodejs_compat"],
  // Reached only through the api.openwaters.io gateway's WATER_LEVELS binding.
  "workers_dev": false,
  "preview_urls": false,
  // The poller's last 8 days (workers/live/schema.sql).
  "d1_databases": [
    { "binding": "LIVE", "database_name": "stillwell-live", "database_id": "TODO-live-db" },
  ],
  // The store.
  "r2_buckets": [{ "binding": "STORE", "bucket_name": "water-levels" }],
  "observability": { "enabled": true },
}
