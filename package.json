{
  "name": "water-levels",
  "description": "Observed and predicted water levels from tide and river gauges, as Parquet",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openwatersio/water-levels.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "ingest": "node scripts/ingest.ts",
    "ticon:inventory": "node scripts/ticon-inventory.ts",
    "evaluate:bsh": "node scripts/evaluate-bsh.ts",
    "evaluate:rws": "node scripts/evaluate-rws.ts",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@duckdb/node-api": "^2.0.0-r.1",
    "@openwaters/almanac": "^0.12.2",
    "@slackwater/engine": "^1.0.0-beta.8",
    "ml-matrix": "^6.15.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
