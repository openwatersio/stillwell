# Template for /etc/stillwell.env (0600, root-owned), read by stillwell-ingest.service. apply.sh installs it
# on a box that has no file yet and never overwrites an existing one.

# The public store, read over HTTPS: the server writes nothing to it (docs/plans/realtime.md).
STILLWELL_STORE=https://stillwell.openwaters.io
# The restricted store, needed only once an hourly source bars republishing; the poller refuses to start
# without it then.
# STILLWELL_RESTRICTED_STORE=
# ClickHouse on loopback, as config.d/stillwell.xml has it. apply.sh adds CLICKHOUSE_PASSWORD, generated on
# the box, and sets it on ClickHouse's default user; the client reads it from here.
CLICKHOUSE_URL=http://127.0.0.1:8123
# An api.data.gov key of the server's own: backfills pace themselves to a key's whole hourly budget.
USGS_API_KEY=
# A fine-grained token for openwatersio/stillwell with Actions: read and write, so a source that reports a
# station in another datum starts its Monthly refresh. Without it the server logs the change and goes on.
GITHUB_TOKEN=
# stillwell-ingest.service sets STILLWELL_METRICS and STILLWELL_FROM_RECENT itself. A line here for either
# replaces the unit's value rather than adding to it.
