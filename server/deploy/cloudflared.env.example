# Template for /etc/cloudflared.env (0600, root-owned), read by cloudflared.service. apply.sh installs it on a
# box that has no file yet and never overwrites an existing one; cloudflared runs once TUNNEL_TOKEN is set.

# The token of the stillwell-1 Tunnel, from Cloudflare's dashboard or API (workers/api/README.md).
TUNNEL_TOKEN=
