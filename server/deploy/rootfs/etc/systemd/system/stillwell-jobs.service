# stillwell-jobs: runs the store's jobs from the queue in /var/lib/stillwell-jobs/jobs.db, each as a transient unit
# stillwell-job-<id> of its own as the stillwell user, and moves the migrations in src/migrations/ on
# (docs/plans/jobs.md). It runs as root to start those units, which read /etc/stillwell.env as it does.
[Unit]
Description=Stillwell store jobs
After=network-online.target
Wants=network-online.target

[Service]
# The queue and the jobs' directories, root's own, so no stillwell process can change what root runs or removes.
StateDirectory=stillwell-jobs
StateDirectoryMode=0755
WorkingDirectory=/var/lib/stillwell-jobs
# STILLWELL_WRITE_STORE and its credentials, and GITHUB_TOKEN, to see that no Actions run still writes a source
# before the server does (src/jobs/actions.ts).
EnvironmentFile=-/etc/stillwell.env
# Beside the poller's, for Alloy's textfile collector.
Environment=STILLWELL_JOBS_METRICS=/var/lib/stillwell/metrics/jobs.prom
ExecStart=/opt/node/bin/node /opt/stillwell/server/jobs.ts
Restart=always
RestartSec=10
# Jobs are units of their own, so stopping or restarting this service leaves them running; a restart reads
# their results.
TimeoutStopSec=30
MemoryMax=600M

[Install]
WantedBy=multi-user.target
