# cloudflared: publishes stillwell-api through a Cloudflare Tunnel behind Access, so no port is open on the
# box. The Tunnel, its public hostname (to http://127.0.0.1:8787) and the Access application are set up in
# Cloudflare (server/deploy/README.md); /etc/cloudflared.env holds the Tunnel's token as TUNNEL_TOKEN.
# apply.sh enables it only once that's filled in.
[Unit]
Description=Cloudflare Tunnel for stillwell-api
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
EnvironmentFile=/etc/cloudflared.env
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run
Restart=always
RestartSec=5
MemoryMax=100M
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
