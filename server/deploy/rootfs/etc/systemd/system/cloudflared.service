# cloudflared: the Cloudflare Tunnel through which the levels Worker reaches stillwell-api as a Workers VPC
# service, so no port is open on the box and the API has no public hostname. The Tunnel and the VPC service
# are set up in Cloudflare (workers/api/README.md); /etc/cloudflared.env holds the Tunnel's token as TUNNEL_TOKEN.
# apply.sh enables it only once that's filled in.
[Unit]
Description=Cloudflare Tunnel for stillwell-api
After=network-online.target
Wants=network-online.target

[Service]
DynamicUser=yes
EnvironmentFile=/etc/cloudflared.env
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run
Restart=always
RestartSec=5
MemoryMax=100M
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
