# Template for /etc/stillwell-jobs.env (0600, root-owned), which every job stillwell-jobs starts reads
# (docs/plans/jobs.md). apply.sh installs it on a box that has no file yet and never overwrites an existing one.
# The poller and stillwell-api never read it, so they never hold the store's write credentials.

# The public store, written as the Ingest workflow writes it.
STILLWELL_STORE=s3://water-levels
# An R2 token that may read and write the water-levels bucket, as the `lake` environment's secrets.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# An api.data.gov key of the jobs' own: a USGS backfill paces itself to a key's whole hourly budget, so the
# poller's key isn't shared.
USGS_API_KEY=
